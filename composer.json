{
    "name": "flobbos/laravel-newsletter-templates",
    "description": "MJML newsletter template workshop for Laravel. No email-service dependency.",
    "keywords": [
        "laravel",
        "newsletter",
        "mjml",
        "templates"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Alexej Krzewitzki",
            "email": "alexej@helloo.it",
            "homepage": "https://helloo.it"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "12.*|13.*"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Flobbos\\NewsletterTemplates\\": "src/"
        },
        "files": [
            "src/Helpers/newsletter_image.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Flobbos\\NewsletterTemplates\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Flobbos\\NewsletterTemplates\\NewsletterTemplatesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "@php vendor/bin/pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
